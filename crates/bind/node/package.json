{
  "name": "verilith",
  "version": "0.1.0",
  "description": "Formally verified (Verus) WHATWG URL and JSON parsers for Node.js",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "license": "MIT OR Apache-2.0",
  "keywords": [
    "url",
    "whatwg",
    "json",
    "parser",
    "verified",
    "verus",
    "napi"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verilith/verilith.git",
    "directory": "crates/bind/node"
  },
  "homepage": "https://github.com/verilith/verilith/tree/main/crates/bind#nodejs-addon",
  "engines": {
    "node": ">= 18.17"
  },
  "napi": {
    "binaryName": "vbind",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.12"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "test": "node --test ../tests/node/test.js"
  },
  "optionalDependencies": {
    "verilith-linux-x64-gnu": "0.1.0",
    "verilith-linux-arm64-gnu": "0.1.0",
    "verilith-linux-x64-musl": "0.1.0",
    "verilith-linux-arm64-musl": "0.1.0",
    "verilith-darwin-x64": "0.1.0",
    "verilith-darwin-arm64": "0.1.0",
    "verilith-win32-x64-msvc": "0.1.0"
  },
  "author": {
    "name": "Verilith contributors",
    "url": "https://github.com/verilith/verilith"
  },
  "bugs": {
    "url": "https://github.com/verilith/verilith/issues"
  }
}
