diff --git a/src/lib/CMakeLists.txt b/src/lib/CMakeLists.txt
index a4c1e73f..8fcc7cc8 100644
--- a/src/lib/CMakeLists.txt
+++ b/src/lib/CMakeLists.txt
@@ -163,3 +163,15 @@ ENDIF ()
 
 
 
+
+# Link vdns (https://github.com/verilith/verilith), built with
+# `cargo build --release --features cares,ares-abi`, in place of c-ares's own
+# ares_dns_parse and ares_expand_name.
+IF (CARES_VDNS_LIB)
+	FOREACH (T ${PROJECT_NAME} ${PROJECT_NAME}_static)
+		IF (TARGET ${T})
+			TARGET_COMPILE_DEFINITIONS (${T} PRIVATE CARES_WITH_VDNS)
+			TARGET_LINK_LIBRARIES (${T} PRIVATE ${CARES_VDNS_LIB} pthread dl m)
+		ENDIF ()
+	ENDFOREACH ()
+ENDIF ()
